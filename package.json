{
  "name": "sift-search",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A BYOK web-search shell backed by the DeepSeek Search API. Static, client-side, no server.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve": "node scripts/serve.mjs dist 8765",
    "e2e": "node e2e/run.mjs",
    "e2e:live": "node e2e/run.mjs --live"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
