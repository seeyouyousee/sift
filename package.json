{
  "name": "sift-search",
  "version": "0.1.0",
  "type": "module",
  "description": "A BYOK web-search shell backed by the DeepSeek Search API: static, client-side, no server. Streamed answers with citations.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve": "node scripts/serve.mjs dist 8765",
    "serve:proxy": "node server/proxy.mjs",
    "e2e": "node e2e/run.mjs",
    "e2e:live": "node e2e/run.mjs --live"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "license": "MIT",
  "keywords": [
    "search",
    "rag",
    "deepseek",
    "byok",
    "static-site",
    "pwa",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/seeyouyousee/sift.git"
  },
  "homepage": "https://github.com/seeyouyousee/sift#readme",
  "author": "Sift contributors"
}
